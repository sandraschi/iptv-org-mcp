# iptv-org-mcp configuration - copy to .env
IPTV_ORG_MCP_HOST=127.0.0.1
IPTV_ORG_MCP_PORT=11242
IPTV_ORG_MCP_TRANSPORT=stdio
IPTV_ORG_MCP_LOG_LEVEL=INFO
# Upstream CDN base (override only for mirrors/tests)
IPTV_ORG_MCP_API_BASE=https://iptv-org.github.io/api
IPTV_ORG_MCP_PLAYLIST_BASE=https://iptv-org.github.io/iptv
# Cache TTL in hours for static JSON (channels/streams/guides)
IPTV_ORG_MCP_CACHE_TTL_HOURS=24
# Local cache dir (JSON snapshots + generated M3Us)
IPTV_ORG_MCP_CACHE_DIR=./data
# Stream probe: timeout seconds + max probes per build_playlist call
IPTV_ORG_MCP_PROBE_TIMEOUT=8
IPTV_ORG_MCP_PROBE_MAX=20
# VLC executable (for play_in_vlc deep-link hint; auto-detected if empty)
IPTV_ORG_MCP_VLC_PATH=
