# Normalize line endings to LF in the repo regardless of what the editing
# tool wrote on disk. Copy of mcp-central-docs/templates/fleet.gitattributes.
* text=auto eol=lf

# Binary -- never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
*.mcpb binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Windows-only scripts keep CRLF (bat/cmd expect it)
*.bat text eol=crlf
*.cmd text eol=crlf
